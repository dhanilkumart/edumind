            </div>

        </div>

        <div class="test-count">
            {{ full_tests|length }} Tests
        </div>

    </div>


    <div class="mock-grid">

        {% for mock_test in full_tests %}

        <div class="mock-card">

            {% if mock_test.id in attempted_test_ids %}
                <div class="status">✓ Attempted</div>
            {% else %}
                <div class="status">✨ New Test</div>
            {% endif %}


{% extends "base.html" %}

{% block title %}{{ subject.name }} Mock Tests{% endblock %}
{% block page_class %}page-subject-mock-tests{% endblock %}

{% block content %}

<style>
.mock-page{max-width:1250px;margin:auto;padding:25px 15px 60px}
.mock-header{text-align:center;padding:42px 20px;margin-bottom:30px;border-radius:28px;color:white;background:linear-gradient(135deg,#667eea,#764ba2,#11998e);box-shadow:0 15px 35px rgba(0,0,0,.16)}
.mock-header h1{margin:0 0 10px;font-size:36px;font-weight:800}
.mock-header p{margin:0;font-size:16px}
.exam-hub{margin-bottom:45px}
.exam-hub-header{display:flex;align-items:center;gap:18px;padding:25px;margin-bottom:22px;border-radius:22px;color:white;box-shadow:0 12px 30px rgba(0,0,0,.14)}
.exam-hub-icon{width:62px;height:62px;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:18px;background:rgba(255,255,255,.18);font-size:34px}
.exam-hub-header h2{margin:0 0 5px;font-size:26px}
.exam-hub-header p{margin:0;font-size:14px;opacity:.9}
.banking-header{background:linear-gradient(135deg,#064e3b,#047857,#10b981)}
.ssc-header{background:linear-gradient(135deg,#1e3a8a,#2563eb,#06b6d4)}
.railway-header{background:linear-gradient(135deg,#7f1d1d,#dc2626,#f97316)}
.exam-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:20px}
.exam-card{position:relative;display:flex;align-items:center;gap:17px;min-height:145px;padding:22px;border-radius:22px;color:white;text-decoration:none;overflow:hidden;box-shadow:0 10px 28px rgba(0,0,0,.13);transition:transform .25s,box-shadow .25s}
.exam-card:hover{transform:translateY(-7px);box-shadow:0 18px 38px rgba(0,0,0,.22)}
.exam-card:after{content:"";position:absolute;width:110px;height:110px;right:-30px;bottom:-35px;border-radius:50%;background:rgba(255,255,255,.12)}
.bank-1{background:linear-gradient(135deg,#1e3a8a,#2563eb)}
.bank-2{background:linear-gradient(135deg,#065f46,#10b981)}
.bank-3{background:linear-gradient(135deg,#7f1d1d,#dc2626)}
.bank-4{background:linear-gradient(135deg,#0369a1,#0ea5e9)}
.bank-5{background:linear-gradient(135deg,#581c87,#9333ea)}
.bank-6{background:linear-gradient(135deg,#166534,#16a34a)}
.bank-7{background:linear-gradient(135deg,#78350f,#d97706)}
.bank-8{background:linear-gradient(135deg,#312e81,#6366f1)}
.ssc-1{background:linear-gradient(135deg,#1e3a8a,#2563eb)}
.ssc-2{background:linear-gradient(135deg,#065f46,#059669)}
.ssc-3{background:linear-gradient(135deg,#7c2d12,#ea580c)}
.ssc-4{background:linear-gradient(135deg,#581c87,#9333ea)}
.ssc-5{background:linear-gradient(135deg,#155e75,#0891b2)}
.ssc-6{background:linear-gradient(135deg,#991b1b,#dc2626)}
.ssc-7{background:linear-gradient(135deg,#854d0e,#ca8a04)}
.rail-1{background:linear-gradient(135deg,#172554,#1d4ed8)}
.rail-2{background:linear-gradient(135deg,#7f1d1d,#dc2626)}
.rail-3{background:linear-gradient(135deg,#9a3412,#ea580c)}
.rail-4{background:linear-gradient(135deg,#064e3b,#059669)}
.exam-icon{position:relative;z-index:2;width:60px;height:60px;flex-shrink:0;display:flex;align-items:center;justify-content:center;border-radius:18px;background:rgba(255,255,255,.18);font-size:31px}
.exam-content{position:relative;z-index:2}
.exam-content h3{margin:0 0 6px;font-size:20px;line-height:1.25}
.exam-content p{margin:0 0 12px;font-size:12px;line-height:1.4;opacity:.9}
.exam-content span{display:inline-block;padding:7px 11px;border-radius:10px;background:rgba(255,255,255,.18);font-size:11px;font-weight:800}
.test-summary{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px;margin-bottom:35px}
.summary-card{background:white;border-radius:18px;padding:18px;text-align:center;box-shadow:0 8px 25px rgba(0,0,0,.08);border:1px solid #eee}
.summary-link{display:block;text-decoration:none;color:inherit;cursor:pointer;transition:transform .25s,box-shadow .25s}
.summary-link:hover{transform:translateY(-5px);box-shadow:0 14px 32px rgba(0,0,0,.14)}
.summary-number{font-size:28px;font-weight:800;color:#667eea}
.summary-label{margin-top:4px;font-size:13px;color:#666;font-weight:600}
.summary-action{margin-top:12px;padding:9px 12px;border-radius:12px;background:linear-gradient(135deg,#667eea,#764ba2);color:white;font-size:12px;font-weight:800}
.test-section{margin-bottom:45px}
.section-heading{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-bottom:18px}
.section-heading-left{display:flex;align-items:center;gap:12px}
.section-icon{width:48px;height:48px;display:flex;align-items:center;justify-content:center;border-radius:15px;background:#f0f3ff;font-size:24px;flex-shrink:0}
.section-heading h2{margin:0;font-size:25px;color:#222}
.section-heading p{margin:3px 0 0;color:#777;font-size:13px}
.test-count{padding:7px 13px;border-radius:20px;background:#f1f3f5;color:#555;font-size:12px;font-weight:700;white-space:nowrap}
.mock-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:20px}
.mock-card{padding:23px;min-height:235px;border-radius:22px;color:white;box-shadow:0 10px 28px rgba(0,0,0,.13);transition:transform .25s,box-shadow .25s;background:linear-gradient(135deg,#667eea,#764ba2)}
.mock-card:hover{transform:translateY(-6px);box-shadow:0 18px 38px rgba(0,0,0,.2)}
.mock-card:nth-child(6n+2){background:linear-gradient(135deg,#11998e,#38ef7d)}
.mock-card:nth-child(6n+3){background:linear-gradient(135deg,#ff9966,#ff5e62)}
.mock-card:nth-child(6n+4){background:linear-gradient(135deg,#396afc,#2948ff)}
.mock-card:nth-child(6n+5){background:linear-gradient(135deg,#f7971e,#ffd200)}
.mock-card:nth-child(6n+6){background:linear-gradient(135deg,#8e2de2,#4a00e0)}
.status{display:inline-block;padding:6px 11px;border-radius:20px;background:rgba(255,255,255,.2);font-size:11px;font-weight:700;margin-bottom:12px}
.mock-icon{font-size:34px;margin-bottom:7px}
.mock-card h3{margin:0 0 8px;font-size:20px;line-height:1.3}
.subject{font-size:13px;opacity:.9;margin-bottom:17px}
.test-info{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}
.info{padding:8px 10px;border-radius:10px;background:rgba(255,255,255,.18);font-size:12px}
.test-btn{display:block;width:100%;box-sizing:border-box;padding:12px;text-align:center;border-radius:12px;background:white;color:#333;text-decoration:none;font-size:13px;font-weight:800}
.test-btn:hover{background:#f5f5f5}
.test-disabled{opacity:.7;cursor:not-allowed}
.empty-box{text-align:center;padding:40px 20px;border-radius:20px;background:#f6f8fb;color:#555}
@media(max-width:700px){
 .mock-page{padding:15px 10px 45px}
 .mock-header{padding:30px 15px;border-radius:22px}
 .mock-header h1{font-size:28px}
 .exam-hub-header{padding:20px}
 .exam-hub-header h2{font-size:22px}
 .exam-grid,.mock-grid,.test-summary{grid-template-columns:1fr;gap:15px}
 .exam-card{min-height:125px;padding:18px}
 .exam-icon{width:52px;height:52px;font-size:27px}
 .exam-content h3{font-size:18px}
 .section-heading h2{font-size:21px}
 .mock-card{min-height:225px;padding:20px}
}
</style>



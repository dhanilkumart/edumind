            <div class="test-info">

                <div class="info">
                    ❓ {{ mock_test.questions.count }} Questions
                </div>

                <div class="info">
                    ⏱️ {{ mock_test.questions.count }} Minutes
                </div>

            </div>

            {% if mock_test.questions.count > 0 %}

            <a
                href="{% url 'test' mock_test.id %}"
                class="test-btn"
            >

                {% if mock_test.id in attempted_test_ids %}
                    🔄 REATTEMPT TEST
                {% else %}
                    ▶️ START TEST
                {% endif %}

            </a>

            {% else %}

            <div class="test-btn test-disabled">
                🔒 AVAILABLE SOON
            </div>

            {% endif %}

        </div>

        {% endfor %}

    </div>

</div>

{% endif %}


